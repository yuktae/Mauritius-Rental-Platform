{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noUncheckedIndexedAccess": true,
    "baseUrl": ".",
    "paths": {
      "@boro/config": ["packages/config/src"],
      "@boro/database": ["packages/database/src"],
      "@boro/types": ["packages/types/src"],
      "@boro/ui": ["packages/ui/src"],
      "@boro/validators": ["packages/validators/src"]
    }
  }
}
