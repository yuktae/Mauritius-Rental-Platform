{
  "name": "mauritius-rental-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @boro/web dev",
    "dev:admin": "pnpm --filter @boro/admin dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:types": "supabase gen types typescript --local > packages/database/src/supabase.types.ts",
    "db:test": "supabase db reset && docker exec -i supabase_db_boro-local psql -U postgres -d postgres -q < supabase/tests/access-control.sql && docker exec -i supabase_db_boro-local psql -U postgres -d postgres -q < supabase/tests/auth-prerequisites.sql"
  },
  "devDependencies": {
    "supabase": "2.114.0",
    "turbo": "2.10.10",
    "typescript": "^5.9.2"
  }
}
