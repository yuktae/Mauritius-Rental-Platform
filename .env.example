# =============================================================================
# BORO environment variables
# -----------------------------------------------------------------------------
# Next.js reads env files from each APP directory, not from the repo root.
# Copy the blocks below into:
#   apps/web/.env.local
#   apps/admin/.env.local
#
# BORO uses Supabase's publishable/secret API keys, not the legacy
# anon/service_role JWTs. Get local values from `supabase start`, and hosted
# values from `supabase projects api-keys --project-ref <ref>`.
#
# Hosted project refs:
#   boro-preprod     fewtgrpknfcquaikdnzo   (Vercel Preview)
#   boro-production  zpmxomlhbzqrmrzcytqi   (Vercel Production)
# =============================================================================

# --- Shared -------------------------------------------------------------------
# local | staging | production
BORO_ENV=local

# --- apps/web (customer app) --------------------------------------------------
# The publishable key is designed to ship to the browser. What protects your
# data is Row Level Security, not hiding this key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# --- apps/admin (operator dashboard) ------------------------------------------
# Same public pair as above, plus the secret key.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
#
# Server-side only. Bypasses every RLS policy. Never prefix it with
# NEXT_PUBLIC_ and never read it from a Client Component. On Vercel it belongs
# to the boro-admin project alone.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# --- Later: production email --------------------------------------------------
# Set once the BORO domain is purchased.
EMAIL_PROVIDER=
EMAIL_FROM_DOMAIN=
