# =============================================================================
# BORO environment variables
# -----------------------------------------------------------------------------
# Next.js reads env files from each APP directory, not from the repo root.
# Copy the blocks below into:
#   apps/web/.env.local
#   apps/admin/.env.local
# For Vercel, set the same keys per project under Settings > Environment Variables.
# =============================================================================

# --- Shared -------------------------------------------------------------------
# local | staging | production
BORO_ENV=local

# --- apps/web (customer app) --------------------------------------------------
# Local: use your machine's LAN IP (not localhost) so phones on the same
# network can reach the Supabase container. Get keys from `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-after-supabase-start

# --- apps/admin (operator dashboard) ------------------------------------------
# Same public pair as above, PLUS the service role key.
# NEVER prefix the service role key with NEXT_PUBLIC_ and never use it in a
# Client Component: it bypasses every RLS policy.
# On Vercel, scope this to the admin project only.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-after-supabase-start
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# --- Later: production email --------------------------------------------------
# Set once the BORO domain is purchased.
EMAIL_PROVIDER=
EMAIL_FROM_DOMAIN=
