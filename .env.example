# Shared
BORO_ENV=local

# Mobile public env values must use EXPO_PUBLIC_ prefix.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-after-supabase-start

# Admin dashboard
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key-after-supabase-start
SUPABASE_SERVICE_ROLE_KEY=local-only-service-role-key

# Later production email provider
EMAIL_PROVIDER=
EMAIL_FROM_DOMAIN=
